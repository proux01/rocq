Variant reverseCoercionProtected' {T T' : Type} : T -> Type :=
  | ReverseCoercionProtected' (coercion : T' -> T) (xres : T') : reverseCoercionProtected' (coercion xres).

Definition reverse_coercion'' : forall {T T' : Type}, forall (xsource : T), @reverseCoercionProtected' T T' xsource -> T' :=
  fun T T' xsource '(ReverseCoercionProtected' _ xres) => xres.

Notation "x" := (reverse_coercion'' x _) (at level 0, x at level 200, only printing). (* TODO: mettre dans un scope *)

Goal @reverse_coercion'' nat bool (1 + 0) (ReverseCoercionProtected' nat_of_bool true) = true.
rewrite addn0.






(* variante sans la preuve d'égalité *)

Variant reverseCoercionProtected {T : Type} (xsource : ReverseCoercionSource T) : Type :=
  | ReverseCoercionProtected.

Definition reverse_coercion' : forall {T T' : Type}, forall (xres : T') (coercion : T' -> T), @reverseCoercionProtected T (coercion xres) -> ReverseCoercionTarget T' :=
  fun T T' xres coercion ph => xres.

Coercion ReverseCoercionProtected : ReverseCoercionSource >-> reverseCoercionProtected.
Coercion reverse_coercion' : reverseCoercionProtected >-> ReverseCoercionTarget.

